<Window x:Class="AppComposer.Views.TextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Text layer"
        Width="350"
        Height="250"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

	<Grid Background="#525252">

		<Grid.RowDefinitions>
			<RowDefinition Height="10" />
			<RowDefinition Height="50" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="10" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="10"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="10"/>
		</Grid.ColumnDefinitions>
		
		<!-- Text -->
        <TextBox Grid.Row="1"
				 Grid.Column="1"
                 Margin="0,0,0,10"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Text}" />

        <!-- Font -->
        <StackPanel Grid.Row="2"
					Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">

            <TextBlock Width="60"
                       VerticalAlignment="Center"
                       Text="Font:"/>

            <ComboBox Width="250"
                      ItemsSource="{Binding TextFonts}"
                      SelectedItem="{Binding SelectedFont}" />
        </StackPanel>

        <!-- Size -->
        <StackPanel Grid.Row="3"
					Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <TextBlock Width="60"
                       VerticalAlignment="Center"
                       Text="Size:"/>

            <ComboBox Width="100"
                      IsEditable="True"
					  ItemsSource="{Binding AvailableFontSizes}"
                      Text="{Binding FontSize}" />

		</StackPanel>

		<!-- Buttons -->
		<StackPanel Grid.Row="4"
					Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

			<Button Click="Ok_Click"
				    Width="80"
                    Margin="0,0,10,0"
                    Content="OK"
                    IsDefault="True"/>

			<Button Click="Cancel_Click"
					Width="80"
                    Content="Cancel"
                    IsCancel="True"/>
		</StackPanel>

	</Grid>
    
</Window>