<Window x:Class="AppComposer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppComposer.Views"
        xmlns:vm="clr-namespace:AppComposer.ViewModels"
        xmlns:views="clr-namespace:AppComposer.Views"
        mc:Ignorable="d"
        Title="Composer" Height="450" Width="800">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CompositionViewModel}">
            <views:CompositionView/>
        </DataTemplate>

    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />

</Window>
