<UserControl x:Class="AppComposer.Views.CompositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppComposer.Views"
             xmlns:vm="clr-namespace:AppComposer.ViewModels.Composition"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="#525252">

        <Button Content="Back"
                Command="{Binding ShowHomeCommand}"
                Width="50"
                Height="20"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,5,5,0"/>

        <Button Content="New Comp"
                Command="{Binding NewCompositionCommand}"
                Width="80"
                Height="30"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,10,0,0"/>

        <Button Content="Load Comp"
                Command="{Binding LoadCompositionCommand}"
                Width="80"
                Height="30"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="120,10,0,0" />

        <Button Content="Save Comp"
                Command="{Binding SaveCompositionCommand}"
                Width="80"
                Height="30"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="210,10,0,0" />

        <Button Content="Add Image"
                Command="{Binding AddImageCommand}"
                Width="80"
                Height="30"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,50,10,0"/>

        <Button Content="Add Text"
                Command="{Binding AddTextCommand}"
                Width="80"
                Height="30"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,100,10,0" />

        <Button Content="Remove"
                Command="{Binding RemoveLayerCommand}"
                Width="80"
                Height="30"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,140,10,0" />

        <Button Content="Scale"
                Command="{Binding ScaleLayerCommand}"
                Width="80"
                Height="30"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,180,10,0" />

        <Button Content="Rotate"
                Command="{Binding RotateLayerCommand}"
                Width="80"
                Height="30"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,220,10,0" />

        <Button Content="Reset"
                Command="{Binding ResetLayerCommand}"
                Width="80"
                Height="30"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,260,10,0" />

        <CheckBox Content="Show Grid"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Right"
                  Margin="0,370,0,0"
                  IsChecked="{Binding IsGridVisible, Mode=TwoWay}">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
            </CheckBox.LayoutTransform>
        </CheckBox>

        <Border BorderBrush="Black"
                BorderThickness="1"
                ClipToBounds="True"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20,0,0,10">

            <Canvas x:Name="CompositionCanvas"
                    Width="{Binding CurrentCanvasSettings.Width}"
                    Height="{Binding CurrentCanvasSettings.Height}"
                    Background="{Binding CurrentCanvasSettings.CanvasBrush}"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseMove="Canvas_MouseMove"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp">

                <!-- Layers -->
                <ItemsControl ItemsSource="{Binding CurrentPageVM.Layers}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="0" />
                            <Setter Property="Canvas.Top" Value="0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type vm:ImageLayerViewModel}">

                            <Grid Name="TranslateGrid">
                                <!-- Use separate grid for scalling to avid gizmo scalling or messing the coordinates -->
                                <Grid Name="ScaleRotateGrid"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      RenderTransformOrigin="0.5,0.5">

                                    <Rectangle  Name="MainLayer"
                                                Width="{Binding Layer.Width}"
                                                Height="{Binding Layer.Height}"
                                                Fill="DarkGray"
                                                Stroke="Black"
                                                StrokeThickness="{Binding SelectionBorderThickness}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                RenderOptions.EdgeMode="Aliased"
                                                Visibility="{Binding Layer.IsVisible, Converter={StaticResource BoolToVis}}"/>

                                    <Rectangle  Name="ScaleOutline"
                                                Width="{Binding Layer.Width}"
                                                Height="{Binding Layer.Height}"
                                                Fill="Transparent"
                                                Stroke="Red"
                                                StrokeThickness="{Binding ScaleOutlineBorderThickness}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                RenderOptions.EdgeMode="Aliased"
                                                Visibility="{Binding ShowScaleManipulator, Converter={StaticResource BoolToVis}}"/>

                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="{Binding Layer.Scale}"
                                                            ScaleY="{Binding Layer.Scale}"/>

                                            <RotateTransform Angle="{Binding Layer.Rotation}"/>

                                        </TransformGroup>
                                    </Grid.RenderTransform>

                                </Grid>

                                <Rectangle Name="ImageScaleGizmo"
                                           Width="{Binding ScaleGizmoSize}"
                                           Height="{Binding ScaleGizmoSize}"
                                           Fill="Red"
                                           Stroke="Red"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           RenderOptions.EdgeMode="Aliased"
                                           Margin="{Binding ScaleGizmoMargin}"
                                           Visibility="{Binding ShowScaleManipulator, Converter={StaticResource BoolToVis}}"/>

                                <Grid.RenderTransform>
                                    <TranslateTransform X="{Binding Layer.PosX}"
                                                        Y="{Binding Layer.PosY}"/>
                                </Grid.RenderTransform>

                            </Grid>

                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:TextLayerViewModel}">

                            <Grid Name="TextTranslateGrid">

                                <Grid Name="TextScaleRotateGrid"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      RenderTransformOrigin="0.5,0.5">

                                    <TextBlock  Text="{Binding TextLayer.Text}"
                                                    FontFamily="{Binding TextLayer.FontName}"
                                                    FontSize="{Binding TextLayer.FontSize}"
                                                    Loaded="TextBlock_Loaded"
                                                    SizeChanged="TextBlock_SizeChanged"/>

                                    <Rectangle  Name="TextOutline"
                                                Width="{Binding Layer.Width}"
                                                Height="{Binding Layer.Height}"
                                                Fill="Transparent"
                                                Stroke="black"
                                                StrokeThickness="{Binding SelectionBorderThickness}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                RenderOptions.EdgeMode="Aliased"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>

                                    <Rectangle Name="TextScaleOutline"
                                               Width="{Binding Layer.Width}"
                                               Height="{Binding Layer.Height}"
                                               Fill="Transparent"
                                               Stroke="Red"
                                               StrokeThickness="{Binding ScaleOutlineBorderThickness}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               RenderOptions.EdgeMode="Aliased"
                                               Visibility="{Binding ShowScaleManipulator, Converter={StaticResource BoolToVis}}"/>

                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="{Binding Layer.Scale}"
                                                            ScaleY="{Binding Layer.Scale}"/>
                                            <RotateTransform Angle="{Binding Layer.Rotation}"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                </Grid>

                                <Rectangle  Width="{Binding ScaleGizmoSize}"
                                            Height="{Binding ScaleGizmoSize}"
                                            Fill="Red"
                                            Stroke="Red"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="{Binding ScaleGizmoMargin}"
                                            Visibility="{Binding ShowScaleManipulator, Converter={StaticResource BoolToVis}}"/>

                                <Grid.RenderTransform>
                                    <TranslateTransform X="{Binding Layer.PosX}"
                                                        Y="{Binding Layer.PosY}"/>
                                </Grid.RenderTransform>

                            </Grid>
                        </DataTemplate>

                    </ItemsControl.Resources>
                </ItemsControl>

            </Canvas>
        </Border>

    </Grid>
</UserControl>
