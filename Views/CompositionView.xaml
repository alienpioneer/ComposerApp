<UserControl x:Class="AppComposer.Views.CompositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppComposer.Views"
             xmlns:vm="clr-namespace:AppComposer.ViewModels.Composition"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="#525252">

        <Button Content="Home"
                Command="{Binding ShowHomeCommand}"
                Width="40"
                Height="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,5,5,0"/>

        <Button Content="New Comp"
                Command="{Binding NewCompositionCommand}"
                Width="70"
                Height="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,10,0,0"/>

        <Button Content="Load Comp"
                Command="{Binding LoadCompositionCommand}"
                Width="70"
                Height="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="110,10,0,0" />

        <Button Content="Save Comp"
                Command="{Binding SaveCompositionCommand}"
                Width="70"
                Height="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="200,10,0,0" />

        <Button Content="Add Image"
                Command="{Binding AddImageCommand}"
                Width="70"
                Height="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,50,20,0"/>

        <Button Content="Add Text"
                Command="{Binding AddTextCommand}"
                Width="70"
                Height="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,90,20,0" />

        <Button Content="Remove"
                Command="{Binding RemoveLayerCommand}"
                Width="70"
                Height="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,130,20,0" />

        <Button Content="Scale"
                Command="{Binding ScaleLayerCommand}"
                Width="70"
                Height="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,170,20,0" />

        <Button Content="Rotate"
                Command="{Binding RotateLayerCommand}"
                Width="70"
                Height="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,210,20,0" />

        <Border BorderBrush="Black"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20,0,0,20">

            <Canvas x:Name="CompositionCanvas"
                    Width="{Binding CurrentCanvasSettings.Width}"
                    Height="{Binding CurrentCanvasSettings.Height}"
                    Background="LightGray"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseMove="Canvas_MouseMove"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp">

                <ItemsControl ItemsSource="{Binding CurrentPageVM.Layers}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Layer.PosX}" />
                            <Setter Property="Canvas.Top" Value="{Binding Layer.PosY}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.Resources>

                        <DataTemplate DataType="{x:Type vm:ImageLayerViewModel}">
                            <Grid>
                                <Rectangle Width="{Binding Layer.Width}"
                                           Height="{Binding Layer.Height}"
                                           Fill="DarkGray"
                                           Stroke="Black"
                                           StrokeThickness="{Binding BorderThickness}"
                                           Visibility="{Binding Layer.IsVisible, Converter={StaticResource BoolToVis}}"/>

                                <Rectangle Width="{Binding Layer.Width}"
                                           Height="{Binding Layer.Height}"
                                           Fill="Transparent"
                                           Stroke="Red"
                                           Visibility="{Binding IsScaleMode, Converter={StaticResource BoolToVis}}"/>

                                <Rectangle Width="{Binding ScaleGizmoSize}"
                                           Height="{Binding ScaleGizmoSize}"
                                           Fill="Red"
                                           Stroke="Red"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="{Binding ScaleGizmoMargin}"
                                           Visibility="{Binding IsScaleMode, Converter={StaticResource BoolToVis}}"/>

                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform  ScaleX="{Binding Layer.Scale}"
                                                         ScaleY="{Binding Layer.Scale}"/>
                                        <RotateTransform Angle="{Binding Layer.Rotation}" />
                                    </TransformGroup>
                                </Grid.RenderTransform>

                            </Grid>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:TextLayerViewModel}">
                            <Grid>
                                <Border BorderBrush="Black" 
                                        BorderThickness="{Binding BorderThickness}"
                                        Visibility="{Binding Layer.IsVisible, Converter={StaticResource BoolToVis}}">

                                    <TextBlock  Text="{Binding Layer.Text}"
                                                FontFamily="{Binding Layer.FontName}"
                                                FontSize="{Binding Layer.FontSize}"
                                                Loaded="TextBlock_Loaded"
                                                SizeChanged="TextBlock_SizeChanged"/>
                                </Border>

                                <Rectangle Width="{Binding Layer.Width}"
                                           Height="{Binding Layer.Height}"
                                           Fill="Transparent"
                                           Stroke="Red"
                                           Visibility="{Binding IsScaleMode, Converter={StaticResource BoolToVis}}"/>

                                <Rectangle Width="{Binding ScaleGizmoSize}"
                                           Height="{Binding ScaleGizmoSize}"
                                           Fill="Transparent"
                                           Stroke="Red"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="{Binding ScaleGizmoMargin}"
                                           Visibility="{Binding IsScaleMode, Converter={StaticResource BoolToVis}}"/>
                                
                            </Grid>
                        </DataTemplate>

                    </ItemsControl.Resources>
                </ItemsControl>
            </Canvas>
        </Border>

    </Grid>
</UserControl>
